# Mot de passe de l'espace admin (/admin). Obligatoire.
ADMIN_PASSWORD=change-moi
# Secret aléatoire qui signe la session admin : openssl rand -hex 32
ADMIN_SECRET=
# Facultatif : paiement par carte via Stripe Checkout. Sans clé, les commandes sont enregistrées « en attente de paiement ».
STRIPE_SECRET_KEY=
# Facultatif : adresse publique du site, utilisée pour les retours de paiement Stripe.
SITE_URL=http://localhost:3000
# Facultatif : dossier où sont stockées les données (par défaut ./data).
DATA_DIR=
