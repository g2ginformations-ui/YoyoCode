 "phrases": [
  {
   "text": "Une lettre de motivation ? Moi ?",
   "t0": 0.25,
   "t1": 3.16
  },
  {
   "text": "Poste de Protecteur de nuit. Il me manque votre lettre de motivation.",
   "t0": 5.46,
   "t1": 9.21
  },
  {
   "text": "Je suis une légende. Les légendes ne postulent pas… elles apparaissent.",
   "t0": 9.56,
   "t1": 15.01
  },
  {
   "text": "Lui aussi est apparu. Avec une lettre sur mesure. Il commence lundi.",
   "t0": 15.41,
   "t1": 19.84
  },
  {
   "text": "Lundi ?!",
   "t0": 20.19,
   "t1": 21.0
  },
  {
   "text": "Et il l'a écrite… en combien de temps ?",
   "t0": 21.3,
   "t1": 23.53
  },
  {
   "text": "Trente secondes. Avec MyMotiv.",
   "t0": 23.83,
   "t1": 26.0
  },
  {
   "text": "Trente secondes… Je fais ça entre deux toits.",
   "t0": 26.4,
   "t1": 29.32
  },
  {
   "text": "Préparez le contrat. Je reviens dans trente secondes.",
   "t0": 29.72,
   "t1": 32.2
  },
  {
   "text": "Il faut aussi votre CV.",
   "t0": 32.75,
   "t1": 34.22
  },
  {
   "text": "… Trente-cinq, alors.",
   "t0": 34.82,
   "t1": 36.86
  },
  {
   "text": "Même les légendes ont besoin d'une lettre. Ta première lettre est offerte. Lien en bio.",
   "t0": 37.76,
   "t1": 42.77
  }
 ],
