 "phrases": [
  {
   "text": "Tu passes combien de temps sur une lettre de motivation ?",
   "t0": 0.5,
   "t1": 3.19,
   "src": [
    0.58,
    3.28
   ]
  },
  {
   "text": "2 h… 3 h…",
   "t0": 3.49,
   "t1": 5.1,
   "src": [
    3.28,
    5.14
   ]
  },
  {
   "text": "Moi ? 30 secondes.",
   "t0": 5.35,
   "t1": 7.07,
   "src": [
    5.14,
    7.25
   ]
  },
  {
   "text": "Avec MyMotiv, tu colles l'offre d'emploi, tu ajoutes ton CV,",
   "t0": 7.97,
   "t1": 11.38,
   "src": [
    8.22,
    11.7
   ]
  },
  {
   "text": "et l'IA rédige une lettre et un CV adaptés à l'entreprise.",
   "t0": 11.46,
   "t1": 14.87,
   "src": [
    11.7,
    15.4
   ]
  },
  {
   "text": "Avec son logo, sans rien inventer sur ton profil.",
   "t0": 14.97,
   "t1": 17.99,
   "src": [
    15.4,
    18.67
   ]
  },
  {
   "text": "Pas de prompt à écrire,",
   "t0": 18.44,
   "t1": 19.7,
   "src": [
    19.5,
    21.11
   ]
  },
  {
   "text": "pas de robot qui déraille au bout de 3 messages,",
   "t0": 19.75,
   "t1": 21.89,
   "src": [
    21.11,
    23.4
   ]
  },
  {
   "text": "juste une candidature qui sort de la pile.",
   "t0": 21.97,
   "t1": 24.62,
   "src": [
    23.4,
    26.05
   ]
  },
  {
   "text": "Et la première lettre est offerte.",
   "t0": 24.87,
   "t1": 26.43,
   "src": [
    26.05,
    27.9
   ]
  },
  {
   "text": "Une candidature complète : 1,99 €,",
   "t0": 26.98,
   "t1": 29.98,
   "src": [
    28.45,
    31.62
   ]
  },
  {
   "text": "la semaine en illimité : 3,99 €, et pour les grosses recherches, l'accès à vie,",
   "t0": 30.06,
   "t1": 35.5,
   "src": [
    31.62,
    37.06
   ]
  },
  {
   "text": "payé une seule fois, sans engagement.",
   "t0": 35.56,
   "t1": 38.8,
   "src": [
    37.06,
    40.47
   ]
  },
  {
   "text": "MyMotiv, ta lettre de motivation en 5 clics,",
