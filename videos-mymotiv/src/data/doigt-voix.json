 "phrases": [
  {
   "text": "Mais pourquoi personne m'a parlé de ce truc avant ?",
   "t0": 0.1,
   "t1": 2.12
  },
  {
   "text": "Tu prends une offre qui te plaît. Y a toujours un bouton partager... tu cliques sur copier le lien.",
   "t0": 2.42,
   "t1": 6.62
  },
  {
   "text": "Tu vas sur MyMotiv, tu mets ton CV, tu colles le lien de l'offre... et il analyse tout.",
   "t0": 6.92,
   "t1": 11.38
