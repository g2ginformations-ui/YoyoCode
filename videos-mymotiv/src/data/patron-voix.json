{
 "duration": 36.9,
 "preroll": 0.35,
 "phrases": [
  {
   "text": "Ton patron va détester cette vidéo.",
   "t0": 0.35,
   "t1": 2.28,
   "src": [
    0.85,
    2.86
   ]
  },
  {
   "text": "Depuis le 1er octobre, saisir les prud'hommes, c'est plus simple.",
   "t0": 2.58,
   "t1": 5.85,
   "src": [
    2.86,
    6.13
   ]
  },
  {
   "text": "Ton dernier bulletin de paie et la liste de tes pièces suffisent.",
   "t0": 6.05,
   "t1": 8.79,
   "src": [
    6.13,
    9.2
   ]
  },
  {
   "text": "Mais tu sais ce qui est encore plus simple ?",
   "t0": 9.09,
   "t1": 11.2,
   "src": [
    9.2,
    11.3
   ]
  },
  {
   "text": "Changer de patron.",
   "t0": 11.55,
   "t1": 13.01,
   "src": [
    11.3,
    12.76
   ]
  },
  {
   "text": "Sauf qu'une lettre de motivation, c'est des heures.",
   "t0": 13.46,
   "t1": 16.06,
   "src": [
    12.76,
    15.36
   ]
  },
  {
   "text": "Un chatbot ? Générique.",
   "t0": 16.21,
   "t1": 17.91,
   "src": [
    15.36,
    17.08
   ]
  },
  {
   "text": "Un outil gratuit ? Une base… à retravailler.",
   "t0": 18.01,
   "t1": 20.78,
   "src": [
    17.08,
    20.4
   ]
  },
  {
   "text": "MyMotiv : tu colles l'offre, t'ajoutes ton CV.",
   "t0": 21.13,
   "t1": 24.18,
   "src": [
    21.2,
    24.28
   ]
  },
  {
   "text": "30 secondes : ta lettre et ton CV adaptés à l'entreprise, avec son logo.",
   "t0": 24.33,
   "t1": 28.63,
   "src": [
    24.28,
    28.95
   ]
  },
  {
   "text": "Ta première lettre est offerte, le lien est en bio.",
   "t0": 28.93,
   "t1": 31.51,
   "src": [
    28.95,
    31.9
   ]
  },
  {
   "text": "Et ton patron ? Il l'apprendra au pot de départ.",
   "t0": 31.76,
   "t1": 34.3,
   "src": [
    31.9,
    34.75
   ]
  }
 ],
