{
 "duration": 55.05,
 "preroll": 0.25,
 "phrases": [
  {
   "text": "Si toi aussi tu vois le mot « alternant » partout…",
   "t0": 0.25,
   "t1": 3.34,
   "src": [
    0.02,
    3.3
   ]
  },
  {
   "text": "tu penses qu'à ton alternance, tu vois que par ça…",
   "t0": 3.54,
   "t1": 6.64,
   "src": [
    3.3,
    6.8
   ]
  },
  {
   "text": "et t'as l'impression que si tu rates cette rentrée… t'es foutu.",
   "t0": 6.89,
   "t1": 10.77,
   "src": [
    6.8,
    11.4
   ]
  },
  {
   "text": "Respire. T'es pas foutu.",
   "t0": 11.32,
   "t1": 13.43,
   "src": [
    11.4,
    13.6
   ]
  },
  {
   "text": "Tu peux commencer ta formation en CFA sans entreprise, et t'as trois mois pour signer ton contrat.",
   "t0": 13.68,
   "t1": 18.72,
   "src": [
    13.6,
    18.86
   ]
  },
  {
   "text": "Trois mois ?",
   "t0": 19.02,
   "t1": 19.93,
   "src": [
    18.86,
    19.95
   ]
  },
  {
   "text": "Alors investis-les dans MyMotiv.",
   "t0": 20.18,
   "t1": 22.25,
   "src": [
    19.95,
    22.11
   ]
  },
  {
   "text": "La meilleure solution pour les alternants.",
   "t0": 22.45,
   "t1": 24.51,
   "src": [
    22.11,
    24.24
   ]
  },
  {
   "text": "Le top du top !",
   "t0": 24.66,
   "t1": 26.03,
   "src": [
    24.24,
    25.65
   ]
  },
  {
   "text": "Les autres outils ?",
   "t0": 26.33,
   "t1": 27.36,
   "src": [
    25.65,
    26.75
   ]
  },
  {
   "text": "Un prompt à écrire, un texte générique… et tout à reprendre.",
   "t0": 27.51,
   "t1": 31.12,
   "src": [
    26.75,
    30.45
   ]
  },
  {
   "text": "Nous ?",
   "t0": 31.37,
   "t1": 31.89,
   "src": [
    30.45,
    31.13
   ]
  },
  {
   "text": "Trente secondes.",
   "t0": 32.09,
   "t1": 33.03,
   "src": [
    31.13,
    32.19
   ]
  },
  {
   "text": "Tu colles l'offre, t'ajoutes ton CV :",
   "t0": 33.33,
   "t1": 35.23,
   "src": [
    32.19,
    34.18
   ]
  },
  {
   "text": "ta lettre d'alternance et ton CV adaptés à l'entreprise,",
   "t0": 35.35,
   "t1": 38.37,
   "src": [
    34.18,
    37.22
   ]
  },
  {
   "text": "avec son logo, sans rien inventer sur toi.",
   "t0": 38.49,
   "t1": 41.03,
   "src": [
    37.22,
    39.79
   ]
  },
  {
   "text": "Et ce que tu vois là ?",
   "t0": 41.33,
   "t1": 42.46,
   "src": [
    39.79,
    41.06
   ]
  },
  {
   "text": "Pas une image générée par IA : que des vraies captures de MyMotiv.",
   "t0": 42.66,
   "t1": 46.38,
   "src": [
    41.06,
    44.95
   ]
  },
  {
   "text": "Ta première lettre est offerte, lien en bio.",
   "t0": 46.68,
   "t1": 48.88,
   "src": [
    44.95,
    47.25
   ]
  },
  {
   "text": "Avec MyMotiv, postule !",
   "t0": 49.13,
   "t1": 50.96,
   "src": [
    47.25,
    49.16
   ]
  },
  {
   "text": "Et fais-toi recruter !",
   "t0": 51.11,
   "t1": 52.45,
   "src": [
    49.16,
    50.55
   ]
  }
 ],
