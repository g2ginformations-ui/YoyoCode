{
 "duration": 42.0,
 "phrases": [
  {
   "text": "Une IA pour écrire ta lettre de motiv ? OK... mais red flag, ou green flag ?",
   "t0": 0.1,
   "t1": 5.38
  },
  {
   "text": "Elle t'invente des expériences pour faire joli ? Red flag.",
   "t0": 5.73,
   "t1": 8.61
  },
  {
   "text": "Elle part de ton CV, et elle invente rien ? Green flag.",
   "t0": 8.76,
   "t1": 11.64
  },
  {
   "text": "Elle te promet un job ? Red flag. Personne peut te promettre ça.",
   "t0": 11.99,
   "t1": 15.65
  },
  {
   "text": "La même lettre pour toutes les offres ? Red flag.",
   "t0": 16.0,
   "t1": 18.55
  },
  {
   "text": "Une lettre par offre, avec le nom et le logo de l'entreprise ? Green flag.",
   "t0": 18.7,
   "t1": 22.33
  },
  {
   "text": "Un abonnement impossible à arrêter ? Red flag.",
   "t0": 22.68,
   "t1": 25.46
  },
  {
   "text": "Sans engagement, et tu résilies en deux clics ? Green flag.",
   "t0": 25.61,
   "t1": 28.76
  },
  {
   "text": "Et à la fin, c'est toi qui relis, qui ajustes, et qui valides.",
   "t0": 29.11,
   "t1": 32.34
  },
  {
   "text": "Sur MyMotiv, c'est green flag partout. Ta première lettre est offerte, lien en bio. Et toi, ton pire red flag en candidature ? Dis-le en commentaire.",
   "t0": 32.69,
   "t1": 40.4
  }
 ],
