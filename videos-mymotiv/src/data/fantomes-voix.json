 "phrases": [
  {
   "text": "Cent candidatures.",
   "t0": 1.6,
   "t1": 3.3
  },
  {
   "text": "Vingt refus.",
   "t0": 3.5,
   "t1": 4.57
  },
  {
   "text": "Et quatre-vingts… fantômes.",
   "t0": 4.72,
   "t1": 6.1
  },
  {
   "text": "Le problème, c'est pas toi.",
   "t0": 6.65,
   "t1": 8.13
  },
  {
   "text": "C'est ta lettre. La même, envoyée partout.",
   "t0": 8.28,
   "t1": 10.91
  },
  {
   "text": "Respire.",
   "t0": 11.31,
   "t1": 12.09
  },
  {
   "text": "Avec MyMotiv, c'est 5 clics.",
   "t0": 12.54,
   "t1": 14.97
  },
  {
   "text": "Ton CV. Le lien de l'offre. Générer.",
   "t0": 15.09,
   "t1": 17.87
  },
  {
   "text": "Trente secondes plus tard, ta lettre est écrite pour cette offre. Avec le logo de l'entreprise.",
   "t0": 18.12,
   "t1": 22.67
  },
  {
   "text": "Ta première lettre est offerte. Après ?",
   "t0": 22.87,
   "t1": 25.28
  },
  {
   "text": "Moins cher qu'un café.",
   "t0": 25.4,
   "t1": 26.79
  },
  {
   "text": "Enregistre cette vidéo pour ta prochaine candidature.",
   "t0": 26.99,
   "t1": 29.44
  },
  {
   "text": "Le lien est en bio.",
   "t0": 29.59,
   "t1": 31.21
  },
  {
   "text": "Postule. Et respire.",
   "t0": 31.46,
   "t1": 33.56
  }
 ],
