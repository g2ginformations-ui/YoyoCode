 "phrases": [
  {
   "text": "Tu repousses encore tes candidatures ? On démonte tes excuses.",
   "t0": 0.25,
   "t1": 3.65
  },
  {
   "text": "« J'ai pas le temps. » Trente secondes par lettre.",
   "t0": 3.95,
   "t1": 6.4
  },
  {
   "text": "« Je sais pas quoi écrire. » Tu colles l'offre : il trouve ce qu'elle cherche vraiment.",
   "t0": 6.7,
   "t1": 11.14
  },
  {
   "text": "« Ça va faire robot. » Zéro phrase toute faite. Et c'est toi qui valides.",
   "t0": 11.44,
   "t1": 15.62
  },
  {
   "text": "« C'est payant. » Ta première lettre est offerte. Sans inscription.",
   "t0": 15.92,
   "t1": 19.7
  },
  {
   "text": "Avec MyMotiv, Léni a envoyé onze candidatures. Sept entretiens.",
   "t0": 20.05,
   "t1": 24.53
  },
  {
   "text": "Alors, plus d'excuse. Lien en bio.",
   "t0": 24.88,
   "t1": 27.18
  }
 ],
