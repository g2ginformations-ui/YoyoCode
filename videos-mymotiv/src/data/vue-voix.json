 "phrases": [
  {
   "text": "Plus personne ne se débarrassera de toi.",
   "t0": 1.25,
   "t1": 3.46,
   "src": [
    1.0,
    3.25
   ]
  },
  {
   "text": "T'as déjà posté un TikTok… et eu zéro vue ?",
   "t0": 3.71,
   "t1": 6.0,
   "src": [
    4.16,
    6.47
   ]
  },
  {
   "text": "Un message laissé en « Vu »…",
   "t0": 6.65,
   "t1": 8.07,
   "src": [
    7.24,
    8.66
   ]
  },
  {
   "text": "Sans réponse ?",
   "t0": 8.17,
   "t1": 8.95,
   "src": [
    8.96,
    9.78
   ]
  },
  {
   "text": "Le dernier choisi au foot… parce qu'il restait que toi ?",
   "t0": 9.3,
   "t1": 12.0,
   "src": [
    10.43,
    13.15
   ]
  },
  {
   "text": "Tes candidatures, c'est pareil.",
   "t0": 13.0,
   "t1": 14.42,
   "src": [
    13.75,
    15.21
   ]
  },
  {
   "text": "Zéro vue.",
   "t0": 14.57,
   "t1": 15.39,
   "src": [
    15.55,
    16.39
   ]
  },
  {
   "text": "Vu.",
   "t0": 15.49,
   "t1": 16.07,
   "src": [
    16.72,
    17.33
   ]
  },
  {
   "text": "Dernier choisi.",
   "t0": 16.17,
   "t1": 17.14,
   "src": [
    17.61,
    18.62
   ]
  },
  {
   "text": "Sauf avec MyMotiv.",
   "t0": 17.44,
   "t1": 18.89,
   "src": [
    19.22,
    20.71
   ]
  },
  {
   "text": "Simple.",
   "t0": 19.09,
   "t1": 19.63,
   "src": [
    20.85,
    21.39
   ]
  },
  {
   "text": "Ton CV, le lien de l'offre. C'est tout.",
   "t0": 19.71,
   "t1": 21.98,
   "src": [
    21.46,
    23.73
   ]
  },
  {
   "text": "Rapide :",
   "t0": 22.13,
   "t1": 22.9,
   "src": [
    24.19,
    24.96
   ]
  },
  {
   "text": "ta lettre en 30 secondes.",
   "t0": 22.95,
   "t1": 24.35,
   "src": [
    25.0,
    26.43
   ]
  },
  {
   "text": "Efficace :",
   "t0": 24.5,
   "t1": 25.21,
   "src": [
    26.73,
    27.44
   ]
  },
  {
   "text": "écrite pour CETTE entreprise, avec son logo.",
   "t0": 25.26,
   "t1": 28.08,
   "src": [
    27.44,
    30.26
   ]
  },
  {
