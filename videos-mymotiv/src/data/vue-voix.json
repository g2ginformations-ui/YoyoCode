   "t1": 23.34,
   "src": [
    24.22,
    25.03
   ]
  },
  {
   "text": "ta lettre en 30 secondes.",
   "t0": 23.39,
   "t1": 25.11,
   "src": [
    25.05,
    26.77
   ]
  },
  {
   "text": "Efficace :",
   "t0": 25.26,
   "t1": 25.96,
   "src": [
    26.77,
    27.47
   ]
  },
  {
   "text": "écrite pour CETTE entreprise, avec son logo.",
   "t0": 26.01,
   "t1": 28.74,
   "src": [
    27.47,
    30.27
   ]
  },
  {
