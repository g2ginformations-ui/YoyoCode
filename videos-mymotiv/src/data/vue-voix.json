 "phrases": [
  {
   "text": "Plus personne ne se débarrassera de toi.",
   "t0": 1.25,
   "t1": 3.46,
   "src": [
    0.97,
    3.25
   ]
  },
  {
   "text": "T'as déjà posté un TikTok… et eu zéro vue ?",
   "t0": 3.71,
   "t1": 6.0,
   "src": [
    4.12,
    6.48
   ]
  },
  {
   "text": "Un message laissé en « Vu »…",
   "t0": 6.65,
   "t1": 8.06,
   "src": [
    7.2,
    8.68
   ]
  },
  {
   "text": "Sans réponse ?",
   "t0": 8.16,
   "t1": 8.96,
   "src": [
    8.93,
    9.8
   ]
  },
  {
   "text": "Le dernier choisi au foot… parce qu'il restait que toi ?",
   "t0": 9.31,
   "t1": 12.01,
   "src": [
    10.39,
    13.16
   ]
  },
  {
   "text": "Tes candidatures, c'est pareil.",
   "t0": 13.01,
   "t1": 14.44,
   "src": [
    13.72,
    15.22
   ]
  },
  {
   "text": "Zéro vue.",
   "t0": 14.59,
   "t1": 15.42,
   "src": [
    15.51,
    16.41
   ]
  },
  {
   "text": "Vu.",
   "t0": 15.52,
   "t1": 16.1,
   "src": [
    16.69,
    17.34
   ]
  },
  {
   "text": "Dernier choisi.",
   "t0": 16.2,
   "t1": 17.19,
   "src": [
    17.57,
    18.63
   ]
  },
  {
   "text": "Sauf avec MyMotiv.",
   "t0": 17.49,
   "t1": 18.95,
   "src": [
    19.19,
    20.72
   ]
  },
  {
   "text": "Simple.",
   "t0": 19.15,
   "t1": 19.69,
   "src": [
    20.82,
    21.43
   ]
  },
  {
   "text": "Ton CV, le lien de l'offre. C'est tout.",
   "t0": 19.77,
   "t1": 22.45,
   "src": [
    21.445,
    24.22
   ]
  },
  {
   "text": "Rapide :",
