 "phrases": [
  {
   "text": "Tu es recruteur. Deux lettres... un seul entretien.",
   "t0": 0.35,
   "t1": 3.58
  },
  {
   "text": "Lettre A : il l'a écrite tout seul, en deux heures. Elle est sincère... mais il y a des fautes.",
   "t0": 3.98,
   "t1": 10.42
  },
  {
   "text": "Lettre B : faite avec une IA, en trente secondes. Zéro faute, et tout ce qu'elle dit vient de son CV.",
   "t0": 10.82,
   "t1": 17.7
  },
  {
   "text": "Même profil. Même poste. Tu prends qui ?",
   "t0": 18.15,
   "t1": 20.66
  },
  {
   "text": "Et interdit de répondre « ça dépend ».",
   "t0": 21.26,
   "t1": 23.54
  },
  {
   "text": "Moi, j'ai bossé dans le recrutement. Je sais lequel j'aurais pris.",
   "t0": 24.04,
   "t1": 27.18
  },
  {
   "text": "Je réponds au commentaire le plus liké. Alors... A ou B ?",
   "t0": 27.58,
   "t1": 31.39
  }
 ],
