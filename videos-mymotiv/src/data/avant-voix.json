{
 "duration": 36.9,
 "preroll": 0.5,
 "phrases": [
  {
   "text": "Avant, une photo floue… on la gardait.",
   "t0": 0.5,
   "t1": 2.94,
   "src": [
    0.19,
    2.68
   ]
  },
  {
   "text": "Aujourd'hui ? On la refait jusqu'à ce qu'elle soit parfaite.",
   "t0": 3.29,
   "t1": 6.13,
   "src": [
    2.68,
    5.59
   ]
  },
  {
   "text": "Avant, on se contentait de peu.",
   "t0": 6.43,
   "t1": 8.83,
   "src": [
    5.96,
    8.365
   ]
  },
  {
   "text": "Mais aujourd'hui, on veut le top du top.",
   "t0": 8.98,
   "t1": 11.4,
   "src": [
    8.365,
    10.78
   ]
  },
  {
   "text": "Les recruteurs, c'est pareil.",
   "t0": 11.7,
   "t1": 13.0,
   "src": [
    10.78,
    12.08
   ]
  },
  {
   "text": "Une lettre copiée-collée… ça se voit.",
   "t0": 13.1,
   "t1": 15.1,
   "src": [
    12.08,
    14.085
   ]
  },
  {
   "text": "Madame, Monsieur…",
   "t0": 15.25,
   "t1": 16.47,
   "src": [
    14.085,
    15.37
   ]
  },
  {
   "text": "C'est pour ça qu'on a créé MyMotiv.",
   "t0": 16.72,
   "t1": 18.56,
   "src": [
    15.96,
    17.87
   ]
  },
  {
   "text": "La référence.",
   "t0": 18.86,
   "t1": 20.16,
   "src": [
    18.36,
    19.73
   ]
  },
  {
   "text": "Pour se faire recruter.",
   "t0": 20.28,
   "t1": 22.15,
   "src": [
    20.49,
    22.43
   ]
  },
  {
   "text": "La meilleure IA",
   "t0": 22.45,
   "t1": 23.84,
   "src": [
    22.87,
    24.33
   ]
  },
  {
   "text": "écrit ta lettre pour CETTE entreprise. En 30 secondes.",
   "t0": 23.94,
   "t1": 27.3,
   "src": [
    25.1,
    28.53
   ]
  },
  {
   "text": "Le top du top.",
   "t0": 27.6,
   "t1": 28.68,
   "src": [
    28.535,
    29.68
   ]
  },
  {
   "text": "Et ta première lettre est offerte.",
   "t0": 28.8,
   "t1": 30.24,
   "src": [
    29.79,
    31.3
   ]
  },
  {
   "text": "Avec MyMotiv, postulez. Et faites-vous recruter.",
   "t0": 30.54,
   "t1": 33.97,
   "src": [
    32.47,
    35.97
   ]
  },
  {
   "text": "Le lien est en bio.",
   "t0": 34.12,
   "t1": 35.1,
   "src": [
    36.105,
    37.15
   ]
  }
 ],
