 "phrases": [
  {
   "text": "Tu viens de regarder une lettre voler pendant sept secondes.",
   "t0": 7.0,
   "t1": 10.42
  },
  {
   "text": "Une lettre... qui n'existe pas.",
   "t0": 10.77,
   "t1": 13.14
  },
  {
   "text": "Et t'es encore là, à attendre qu'elle arrive.",
   "t0": 13.59,
   "t1": 16.21
  },
  {
   "text": "Maintenant, imagine que c'était ta candidature.",
   "t0": 16.66,
   "t1": 19.58
  },
  {
   "text": "MyMotiv écrit des lettres pensées pour qu'on lise la suite : faites pour l'offre, avec tes vraies preuves.",
   "t0": 19.88,
   "t1": 26.26
  },
  {
   "text": "MyMotiv. Postulez. Et faites-vous recruter.",
   "t0": 28.56,
   "t1": 31.78
  },
  {
   "text": "La semaine illimitée : 3,99 €. Un centime de plus que deux lettres à l'unité.",
   "t0": 32.38,
   "t1": 38.32
  },
  {
   "text": "Et ta première lettre est offerte. Commente IMPACT, on t'envoie le lien.",
   "t0": 38.72,
   "t1": 42.9
  }
