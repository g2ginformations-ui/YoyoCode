 "phrases": [
  {
   "text": "Tu viens de regarder un ballon pendant sept secondes.",
   "t0": 7.5,
   "t1": 10.26
  },
  {
   "text": "Un ballon... qui n'existe pas.",
   "t0": 10.61,
   "t1": 12.97
  },
  {
   "text": "Et t'es encore là, à attendre qu'il éclate.",
   "t0": 13.42,
   "t1": 16.18
  },
  {
   "text": "Maintenant, imagine que c'était... ta lettre de motivation.",
   "t0": 16.68,
   "t1": 20.66
  },
  {
   "text": "MyMotiv l'écrit pour qu'on ait envie de lire la suite : faite pour l'offre, avec tes vraies preuves.",
   "t0": 20.96,
   "t1": 26.69
  },
  {
   "text": "La Semaine illimitée : 3,99 €. Un centime de plus que deux lettres à l'unité.",
   "t0": 27.59,
   "t1": 33.53
  },
  {
   "text": "Sans engagement. Et ta première lettre est offerte.",
   "t0": 33.88,
   "t1": 36.81
  },
  {
   "text": "Commente... POP !",
   "t0": 37.41,
   "t1": 38.95
  },
  {
   "text": "On t'envoie le lien.",
   "t0": 40.45,
   "t1": 41.4
  }
 ],
