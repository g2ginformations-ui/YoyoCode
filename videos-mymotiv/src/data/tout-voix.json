 "phrases": [
  {
   "text": "Tu cherches une alternance ? Regarde ça avant d'envoyer ta prochaine candidature.",
   "t0": 0.1,
   "t1": 3.55
  },
  {
   "text": "La même lettre envoyée à tout le monde, ça se voit. Mais en écrire une par offre... ça te prend toute ta soirée.",
   "t0": 3.85,
   "t1": 9.12
  },
  {
   "text": "Sur MyMotiv, tu mets ton CV. Même en photo, ça marche.",
   "t0": 9.42,
   "t1": 12.65
  },
  {
   "text": "Tu colles le lien de l'offre... et en trente secondes, t'as une lettre faite pour cette offre, avec tes vraies preuves.",
   "t0": 12.9,
   "t1": 17.83
  },
  {
   "text": "Avec MyMotiv, Léni a envoyé onze candidatures. Sept entretiens.",
   "t0": 18.18,
   "t1": 22.17
  },
  {
   "text": "Ta première lettre est offerte. Après, c'est 1,99 € la lettre, avec ton CV adapté.",
   "t0": 22.52,
   "t1": 27.25
  },
  {
   "text": "Le lien est en bio. Ta première lettre, teste-la ce soir.",
   "t0": 27.55,
   "t1": 30.48
  }
 ],
