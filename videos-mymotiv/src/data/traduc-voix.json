 "phrases": [
  {
   "text": "Ta lettre de motivation... traduite en langage recruteur.",
   "t0": 0.2,
   "t1": 3.48
  },
  {
   "text": "« Je suis dynamique et motivé »",
   "t0": 3.73,
   "t1": 5.65
  },
  {
   "text": "Traduction : j'ai aucun exemple.",
   "t0": 5.75,
   "t1": 8.07
  },
  {
   "text": "« Je me permets de vous écrire »",
   "t0": 8.32,
   "t1": 9.97
  },
  {
   "text": "Pardon d'exister.",
   "t0": 10.07,
   "t1": 11.33
  },
  {
   "text": "« Fort de mon expérience »",
   "t0": 11.58,
   "t1": 13.08
  },
  {
   "text": "J'ai fait un stage.",
   "t0": 13.18,
   "t1": 14.37
  },
  {
   "text": "« Au sein de votre prestigieuse entreprise »",
   "t0": 14.62,
   "t1": 17.0
  },
  {
   "text": "J'ai pas lu ce que vous faites.",
   "t0": 17.1,
   "t1": 18.83
  },
  {
   "text": "« Je suis convaincu que mon profil correspond parfaitement »",
   "t0": 19.08,
   "t1": 22.04
  },
  {
   "text": "J'ai envoyé la même à tout le monde.",
   "t0": 22.14,
   "t1": 24.02
  },
  {
   "text": "MyMotiv les a toutes interdites. Ta lettre parle de leur offre, avec tes vraies preuves. Première lettre offerte, lien en bio.",
   "t0": 24.27,
   "t1": 30.05
  },
  {
   "text": "« Je souhaite relever de nouveaux défis »",
   "t0": 30.3,
   "t1": 32.28
  },
  {
   "text": "À toi de traduire celle-là. En commentaire.",
   "t0": 32.38,
   "t1": 34.44
  }
 ],
