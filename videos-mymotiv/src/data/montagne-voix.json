 "phrases": [
  {
   "text": "Comment faire une montagne de cash. En quatre étapes.",
   "t0": 0.15,
   "t1": 2.74
  },
  {
   "text": "Un : tu trouves une offre qui te plaît.",
   "t0": 3.04,
   "t1": 4.89
  },
  {
   "text": "Deux : tu écris une lettre qui part de l'offre. Ça, MyMotiv le fait pour toi.",
   "t0": 5.14,
   "t1": 9.54
  },
  {
   "text": "Trois : tu décroches le poste. Ça, ça dépend de toi… donne-toi toutes les chances.",
   "t0": 9.79,
   "t1": 14.42
  },
  {
   "text": "Quatre : premier salaire, mille quatre cents euros. Tout en billets de cinq… deux cent quatre-vingts billets. Et tu empiles.",
   "t0": 14.67,
   "t1": 20.76
  },
  {
   "text": "Regarde-moi… cette montagne.",
   "t0": 21.06,
   "t1": 23.4
  },
  {
   "text": "Bon. C'est une colline.",
   "t0": 24.0,
   "t1": 26.44
  },
  {
   "text": "Montagne ou colline ? Dis-le en commentaire. Première lettre offerte, lien en bio.",
   "t0": 26.79,
   "t1": 31.11
  }
 ],
