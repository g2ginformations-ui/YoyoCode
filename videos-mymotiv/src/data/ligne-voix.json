{
 "duration": 30.93,
 "phrases": [
  {
   "text": "Ta lettre de motivation se joue sur une seule ligne.",
   "t0": 0.15,
   "t1": 2.66
  },
  {
   "text": "La première. Le recruteur lit tout le reste à travers elle.",
   "t0": 2.96,
   "t1": 6.01
  },
  {
   "text": "C'est l'effet de halo : une bonne première impression… et tout le reste paraît meilleur.",
   "t0": 6.21,
   "t1": 10.45
  },
  {
   "text": "« Je me permets de vous adresser ma candidature »… et toute ta lettre devient banale.",
   "t0": 10.65,
   "t1": 14.75
  },
  {
   "text": "Ouvre sur leur besoin, avec une preuve de toi… et là, il lit toute la suite.",
   "t0": 14.95,
   "t1": 18.9
  },
  {
   "text": "C'est exactement ce que fait MyMotiv. Le lien de l'offre, ton CV… et ta première ligne frappe juste.",
   "t0": 19.1,
   "t1": 24.7
  },
  {
   "text": "Première lettre offerte, lien en bio. Et colle ta première ligne en commentaire : je te dis si elle passe.",
   "t0": 24.9,
   "t1": 29.53
  }
 ],
