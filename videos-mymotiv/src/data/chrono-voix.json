{
 "duration": 34.538,
 "phrases": [
  {
   "text": "Donne-moi trente secondes.",
   "t0": 0.3,
   "t1": 1.4
  },
  {
   "text": "C'est le temps qu'il faut à MyMotiv pour écrire ta lettre de motivation.",
   "t0": 1.643,
   "t1": 5.043
  },
  {
   "text": "Pas une lettre bateau : une lettre pour CETTE offre, avec le logo de l'entreprise… et ton CV adapté.",
   "t0": 5.287,
   "t1": 10.847
  },
  {
   "text": "Toi, pendant ce temps-là, t'aurais écrit… « Madame, Monsieur ».",
   "t0": 11.09,
   "t1": 15.36
  },
  {
   "text": "Léni a envoyé onze candidatures avec MyMotiv. Résultat : sept entretiens !",
   "t0": 15.604,
   "t1": 20.444
  },
  {
   "text": "Ta première lettre est offerte. Sans inscription. Sans carte bancaire.",
   "t0": 20.687,
   "t1": 24.327
  },
  {
   "text": "Ouvre une offre qui te plaît, copie le lien… lien en bio.",
   "t0": 24.571,
   "t1": 27.461
  },
  {
   "text": "Trois… deux… un… Et voilà : ta lettre est prête !",
   "t0": 27.808,
   "t1": 31.738
  }
 ],
