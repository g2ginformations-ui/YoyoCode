 "phrases": [
  {
   "text": "Combien ça coûte, une lettre qui sort de la pile ?",
   "t0": 0.25,
   "t1": 2.78
  },
  {
   "text": "La première ? Zéro euro. Sans inscription.",
   "t0": 3.08,
   "t1": 5.87
  },
  {
   "text": "Ensuite, un euro quatre-vingt-dix-neuf la lettre, avec ton CV adapté à l'offre.",
   "t0": 6.17,
   "t1": 10.65
  },
  {
   "text": "Ou trois euros quatre-vingt-dix-neuf la semaine : lettres illimitées, pour toute ta salve.",
   "t0": 10.95,
   "t1": 15.48
  },
  {
   "text": "Sans engagement. Résiliable en deux clics.",
   "t0": 15.78,
   "t1": 18.52
  },
  {
   "text": "Moins cher qu'un kebab.",
   "t0": 18.82,
   "t1": 20.48
  },
  {
   "text": "Ta première lettre est offerte. Lien en bio.",
   "t0": 20.83,
   "t1": 23.41
  }
