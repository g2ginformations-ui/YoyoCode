# Clé API Anthropic (https://console.anthropic.com/settings/keys)
ANTHROPIC_API_KEY=sk-ant-...

# Stripe (https://dashboard.stripe.com/apikeys) — clé "sk_live_..." pour les vrais paiements, "sk_test_..." pour tester
STRIPE_SECRET_KEY=sk_live_...
# Les prix des offres sont définis dans lib/pricing.ts
# Optionnel : code fiscal du produit (par défaut txcd_10103000, « Software as a service — personal use »)
# STRIPE_TAX_CODE=txcd_10103000

# Secret aléatoire pour signer les sessions et les liens de connexion (ex. : openssl rand -hex 32)
ACCESS_SECRET=

# Envoi des liens de connexion par e-mail : Gmail (gratuit) avec un mot de passe d'application
# (https://myaccount.google.com/apppasswords, validation en deux étapes requise)
# GMAIL_USER=vous@gmail.com
# GMAIL_APP_PASSWORD=abcd efgh ijkl mnop
# …ou Resend (https://resend.com), sur un domaine vérifié
RESEND_API_KEY=re_...
# Expéditeur, sur un domaine vérifié dans Resend
EMAIL_FROM="Lettre IA <connexion@votre-domaine.fr>"
# URL publique du site, ex. https://lettre-ia.fr (facultatif, déduite de la requête sinon)
# APP_URL=
# Mettre à true en développement pour générer sans payer
# PAYWALL_DISABLED=true

# Google AdSense (facultatif) — publicités affichées aux visiteurs non abonnés uniquement
# NEXT_PUBLIC_ADSENSE_CLIENT=ca-pub-0000000000000000
# NEXT_PUBLIC_ADSENSE_SLOT=0000000000

# Lettre offerte aux visiteurs non abonnés (mettre false pour la désactiver)
# FREE_TRIAL=true

# Avis clients : base Redis Upstash (Vercel → Storage → Upstash for Redis), variables ajoutées par Vercel
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# Connexion avec Google (facultatif) : identifiants OAuth « Application Web » sur console.cloud.google.com
# URI de redirection autorisé : https://<votre-site>/api/auth/google/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Connexion avec Apple (facultatif, compte Apple Developer requis) : Services ID, Team ID, Key ID et clé .p8
# APPLE_SERVICES_ID=
# APPLE_TEAM_ID=
# APPLE_KEY_ID=
# APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# Mot de passe de l'espace de modération des avis (https://<votre-site>/admin/avis)
# ADMIN_PASSWORD=
