# Clé API Anthropic (https://console.anthropic.com/settings/keys)
ANTHROPIC_API_KEY=sk-ant-...

# Stripe (https://dashboard.stripe.com/apikeys) — clé "sk_live_..." pour les vrais paiements, "sk_test_..." pour tester
STRIPE_SECRET_KEY=sk_live_...
# Optionnel : ID d'un prix créé dans Stripe (sinon 19,95 € est défini dans le code)
# STRIPE_PRICE_ID=price_...

# Secret aléatoire pour signer le cookie d'accès (ex. : openssl rand -hex 32)
ACCESS_SECRET=
# Durée de l'accès après paiement, en jours
ACCESS_DAYS=30
# URL publique du site, ex. https://lettre-ia.fr (facultatif, déduite de la requête sinon)
# APP_URL=
# Mettre à true en développement pour générer sans payer
# PAYWALL_DISABLED=true
